# ============================================================================
# Miyaris Backend — Örnek environment dosyası
# `cp .env.example .env` ile başla, sonra değerleri kendine göre değiştir.
# ============================================================================

# Uygulama
APP_NAME=miyaris
DEBUG=true

# PostgreSQL bağlantısı (asyncpg sürücüsü)
DATABASE_URL=postgresql+asyncpg://miyaris:miyaris@localhost:5432/miyaris_db

# JWT — production'da 32+ karakterli rastgele bir secret olmalı
JWT_SECRET_KEY=change-this-to-a-random-secret-min-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Servisler arası anahtar (AI worker → Miyaris API).
# Boş bırakılırsa /api/v1/service/* endpoint'leri 401 döner.
SERVICE_API_KEY=

# NVİ KPSPublic T.C. kimlik doğrulama servisi.
#   false (default) → dev/CI'da kayıt akışı NVI'ya bağımlı olmaz; kullanıcı
#       kayıt olur ama kyc_verified=False kalır (admin manuel onaylayabilir).
#   true             → production'da kullanılır; her kayıtta NVI SOAP API
#       çağrılır, eşleşmezse 400 döner.
NVI_VERIFICATION_ENABLED=false
NVI_TIMEOUT_SECONDS=10

# Güvenilen reverse proxy sayısı (X-Forwarded-For'dan client IP çıkarımı).
# Client IP, XFF'in SAĞINDAN bu kadar girdi geri sayılarak okunur — ilk
# (en soldaki) girdi client tarafından spoof'lanabilir, bu yüzden sağdan.
#   1 → tek proxy (Render edge). Lokal dev'de XFF yok, değer önemsiz.
#   2 → Render önünde ayrıca Cloudflare vb. varsa.
# Yanlış değer rate-limit (brute-force) bypass'ına ve hatalı audit IP'sine yol açar.
TRUSTED_PROXY_HOPS=1

# Kapora (deposit) ödeme mock'u.
#   false (production default) → gerçek POS yokken kapora endpoint'i 503 döner;
#       kimse 0 TL ile teklif hakkı kazanamaz (anti-troll koruması korunur).
#   true                       → mock aktif, endpoint çağrılınca hemen "ödendi"
#       olur. Dev/staging (APP_ENV != production) zaten mock'u her zaman çalıştırır;
#       bu flag yalnızca production'da etkili. iyzico bağlanınca kaldırılacak.
DEPOSIT_MOCK_ENABLED=false

# Frontend origin'leri — production'da Vercel/CloudFront URL'leri eklenir
CORS_ORIGINS=["http://localhost:3000"]

# Scheduler (auction yaşam döngüsü). Multi-replica deployment'larda yalnızca
# tek instance'ta 1 olarak set'lenmeli, diğerlerinde 0.
RUN_SCHEDULER=1
