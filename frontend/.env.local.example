# ============================================================================
# Miyaris Frontend — Örnek environment dosyası (Vercel + lokal dev)
# `cp .env.local.example .env.local` ile başla.
# ============================================================================

# Backend API URL — server-side fetch için (route handler'lar + server
# components). Production'da Vercel dashboard'a tek bir tanesi yeter.
#
# Yerel:      http://localhost:8000
# Production: https://miyaris-backend.onrender.com
BACKEND_API_URL=http://localhost:8000

# Aynı URL'in public versiyonu — useAuctionStream WebSocket hook'u
# `ws://...` türevini buradan çıkarır. NEXT_PUBLIC_ prefix'i bundle'a
# girer; client-side erişim için zorunlu.
NEXT_PUBLIC_API_URL=http://localhost:8000

# (Opsiyonel) WebSocket URL'ini açıkça override etmek istersen.
# Boş bırakırsan NEXT_PUBLIC_API_URL'ten otomatik türetilir.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

NEXT_PUBLIC_APP_NAME=Miyaris
