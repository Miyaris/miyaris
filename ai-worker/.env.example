# Miyaris backend bağlantısı
MIYARIS_API_URL=http://localhost:8000
SERVICE_API_KEY=change-this-must-match-miyaris-backend

# Polling
POLL_INTERVAL_SECONDS=15
BATCH_SIZE=5

# LLM seçimi
# - OLLAMA_BASE_URL set ise Ollama kullanılır (lokal, ücretsiz)
# - Hiçbiri set değilse StubLLM ile çalışır (deterministik mock — pipeline testi için)
# Production'da Ollama veya OpenAI'a geçilecek.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
